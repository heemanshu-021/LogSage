# ── LogSage Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/logsage.db

# ── ML / Model ─────────────────────────────────────────────────────────────
# Sentence-Transformer model for runbook embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Anomaly detector: isolation_forest | lof | autoencoder
ANOMALY_MODEL=isolation_forest
ANOMALY_THRESHOLD=0.5
# Path where trained model artifacts are saved
MODEL_SAVE_DIR=ml/models/saved

# ── Local Accounts ────────────────────────────────────────────────────────
# The Docker Compose deployment requires these values. Generate a private
# random secret and replace the example admin credentials before starting it.
AUTH_REQUIRED=true
AUTH_SECRET_KEY=change-me
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_SESSION_TTL_SECONDS=43200
# Keep false for the localhost-only HTTP Compose deployment. Set true behind HTTPS.
AUTH_COOKIE_SECURE=false
# Remove AUTH_ADMIN_PASSWORD after the first account is created; it is bootstrap-only.

# ── LLM / AI Incident Triage Engine ────────────────────────────────────────
# Leave LLM_API_KEY blank to operate in automatic retrieval_fallback mode.
LLM_API_KEY=
LLM_PROVIDER=openai               # openai | gemini | generic_http
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=15.0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# ── Drain3 Parser ──────────────────────────────────────────────────────────
DRAIN_DEPTH=4
DRAIN_SIM_TH=0.4
DRAIN_MAX_CHILDREN=100

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (React / Vite) ────────────────────────────────────────────────
# Optional cross-origin API override. By default the frontend uses same-origin /api routes.
VITE_API_URL=
# Optional Vite development proxy target (defaults to http://localhost:8000).
VITE_API_PROXY_TARGET=http://localhost:8000
