# ── LogSage Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/logsage.db

# ── ML / Model ─────────────────────────────────────────────────────────────
# Sentence-Transformer model for runbook embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Anomaly detector: isolation_forest | lof | autoencoder
ANOMALY_MODEL=isolation_forest
ANOMALY_THRESHOLD=0.5
# Path where trained model artifacts are saved
MODEL_SAVE_DIR=ml/models/saved

# ── Drain3 Parser ──────────────────────────────────────────────────────────
DRAIN_DEPTH=4
DRAIN_SIM_TH=0.4
DRAIN_MAX_CHILDREN=100

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (React) ───────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
