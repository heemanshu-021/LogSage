FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL_SAVE_DIR=/app/ml/models/saved

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt \
    && groupadd --system logsage \
    && useradd --system --gid logsage --uid 10001 --home-dir /app logsage

COPY backend/ ./backend/
COPY ml/ ./ml/
COPY runbooks/ ./runbooks/

RUN mkdir -p /app/data /app/ml/models/saved \
    && chown -R logsage:logsage /app/data /app/ml

USER logsage

EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
